# Optional: the same key can instead be saved in the game's AI settings.
OPENROUTER_API_KEY=
PORT=3211
BIND_HOST=127.0.0.1
# Exact public site origin when using a reverse proxy (no path or trailing route).
# PUBLIC_ORIGIN=https://draw.example.com
# Public registration and invitation-only guest entry are enabled by default.
ALLOW_REGISTRATION=true
ALLOW_GUESTS=true
# Game budgets reset at 00:00 UTC. AI retries count as calls.
MAX_DAILY_MATCHES=20
MAX_DAILY_AI_CALLS=300
MAX_DAILY_TOTAL_AI_CALLS=1000
# Optional 32-byte Base64 (or 64 hex characters) key. Keep it separate from DB backups.
# If omitted, the server generates .local/config-master.key; preserve it across upgrades.
# CONFIG_ENCRYPTION_KEY=
# Optional local data directory; never commit it.
# DRAW_GUESS_DATA_DIR=
